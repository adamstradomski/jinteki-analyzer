# Security headers for every static page and file (Workers static assets; this file is not served).
# They don't reach the shortener's own responses (/s/*, /api/*): src/index.js sets the same ones there.
# Each page also sets its Content-Security-Policy in a <meta> tag, which also covers local
# development; frame-ancestors only works as a header, so it is set here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

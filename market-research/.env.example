# Market Research runner configuration. Copy to market-research.env and fill in.
# Never commit real values.

# Cloudflare R2 (S3 API). One token scoped to the three buckets, object read/write only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
MR_BUCKET_SOURCE=mr-source
MR_BUCKET_CANONICAL=mr-canonical
MR_BUCKET_PUBLISHED=mr-published

# Contact included in the User-Agent (an email or URL where source maintainers can reach you).
CONTACT=

# Optional tuning (defaults shown). See the configuration table in README.md.
# MR_BUDGET=400
# MR_BUDGET_ABR=400
# MR_BUDGET_COBRA=400
# MR_BUDGET_NRDB=400
# MR_RATE_ABR_S=2
# MR_RATE_COBRA_S=2
# MR_RATE_NRDB_S=1
# MR_JITTER_ABR=0.2
# MR_JITTER_COBRA=0.2
# MR_JITTER_NRDB=0.2
# MR_MIN_PLAYERS=8
# MR_COVERAGE_HC=0.7
# MR_MIN_GAMES=30
# MR_MIN_ENTRIES=20
# MR_PERIOD_MONTHS=3

# Local development only: use a directory instead of R2.
# MR_LOCAL_STORE=/tmp/market-research-store
